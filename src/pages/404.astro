---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到" description="你访问的页面不存在。" noindex>
  <div class="container error-page">
    <div>
      <div class="error-code">404</div>
      <h1>这一页还没有被写下</h1>
      <p class="page-intro">也许链接已经改变，或者它只是暂时迷路了。</p>
      <div class="hero-actions" style="justify-content:center;margin-top:28px">
        <a class="button button-primary" href="/">返回首页</a>
        <a class="button button-secondary" href="/archive/">浏览文章</a>
      </div>
    </div>
  </div>
</BaseLayout>
