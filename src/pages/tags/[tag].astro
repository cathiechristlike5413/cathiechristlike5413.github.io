---
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allTags, getPublishedPosts, slugifyTag, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return allTags(posts).map((tag) => ({
    params: { tag: slugifyTag(tag) },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.includes(tag)),
    },
  }));
}

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`浏览与 ${tag} 相关的全部文章。`}>
  <div class="container page-shell">
    <header class="page-header">
      <div>
        <div class="eyebrow">Topic</div>
        <h1 class="page-title">#{tag}</h1>
        <p class="page-intro">这个主题下共有 {posts.length} 篇文章。</p>
      </div>
      <a class="button button-secondary" href="/tags/">全部标签</a>
    </header>
    <div class="post-grid">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </div>
</BaseLayout>
